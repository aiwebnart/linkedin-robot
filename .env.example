# Local only. Never commit real values; use GitHub Actions secrets in production.
# Set this to true only after LinkedIn has approved the application and scopes.
LINKEDIN_AUTOMATION_APPROVED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:YOUR_MEMBER_ID
LINKEDIN_TOKEN_EXPIRES_AT=2026-09-01T00:00:00.000Z
# Use a currently supported version shown in LinkedIn's Developer Portal.
LINKEDIN_API_VERSION=202607